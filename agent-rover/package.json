{
  "name": "agent-rover",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "npm run build && vitest run",
    "pack": "npm run test && screw-up pack --pack-destination ../artifacts/"
  },
  "dependencies": {
    "@tesseract.js-data/eng": ">=1.0.0",
    "async-primitives": ">=1.7.0",
    "pixelmatch": ">=7.2.0",
    "pngjs": ">=7.0.0",
    "ssim.js": ">=3.5.0",
    "tesseract.js": ">=7.0.0"
  },
  "devDependencies": {
    "@types/node": ">=20.0.0",
    "@types/pixelmatch": ">=5.2.6",
    "@types/pngjs": "^6.0.5",
    "prettier-max": ">=1.16.0",
    "screw-up": ">=1.33.0",
    "typescript": ">=5.0.0",
    "vite": ">=6.0.0",
    "vitest": ">=2.0.0"
  }
}
